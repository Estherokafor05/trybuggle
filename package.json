{
  "name": "trybuggle",
  "version": "0.1.0",
  "private": true,
  "description": "Buggle Learn: AI literacy for everyday life and work.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs && npm run test:db",
    "test:browser": "playwright test",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "db:import-course": "tsx --env-file=.env.local scripts/import-course.ts",
    "test:db": "tsx --test tests/db/*.test.ts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@types/qrcode": "^1.5.6",
    "better-auth": "^1.7.28",
    "next": "^16.4.6",
    "pdf-lib": "1.17.1",
    "pg": "^8.23.1",
    "postgres": "^4.1.1",
    "posthog-js": "1.444.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stripe": "^23.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.6.0",
    "@electric-sql/pglite-socket": "^0.3.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "22.10.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "5.7.3"
  }
}
