# Google sign-in via Auth.js. Put the credential values in .env.local.
# Local callback: http://localhost:3000/api/auth/callback/google
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Managed PostgreSQL. Use the pooled URL for application requests.
DATABASE_URL=
# Optional direct URL for migrations. Falls back to DATABASE_URL when absent.
DATABASE_URL_UNPOOLED=
