# Google sign-in via Auth.js. Put the credential values in .env.local.
# Local callback: http://localhost:3000/api/auth/callback/google
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Waitlist storage is not wired up yet.
# When you pick a store (Postgres, Supabase, Airtable, a Google Sheet),
# put its connection details here and read them in src/app/api/waitlist/route.ts.

# WAITLIST_DATABASE_URL=
