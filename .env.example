# Sign-in (Better Auth): email and password, plus Google. Put values in .env.local.
# AUTH_SECRET signs sessions; generate one with: openssl rand -base64 32
# Google callback: http://localhost:3000/api/auth/callback/google
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Account emails (confirm email, reset password) via Resend.
# Without a key, test sites print the link in the server log instead.
RESEND_API_KEY=
# Once a sending domain is verified in Resend, e.g. "Buggle Learn <hello@yourdomain.com>".
EMAIL_FROM=

# Managed PostgreSQL. Use the pooled URL for application requests.
DATABASE_URL=
# Optional direct URL for migrations. Falls back to DATABASE_URL when absent.
DATABASE_URL_UNPOOLED=

# Secret Vercel Cron sends to /api/cron/guest-cleanup (set in Vercel only).
CRON_SECRET=

# PostHog (optional). Public project key; analytics only runs after a learner agrees.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
